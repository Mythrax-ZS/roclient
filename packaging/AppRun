#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tenseiga"
mkdir -p "$CFG_DIR"
if [ ! -f "$CFG_DIR/local.toml" ]; then
  cp "$HERE/usr/share/tenseiga/example.toml" "$CFG_DIR/local.toml"
fi
export ROCLIENT_CONFIG="${ROCLIENT_CONFIG:-$CFG_DIR/local.toml}"
exec "$HERE/usr/bin/tenseiga" "$@"
